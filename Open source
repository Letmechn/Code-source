local endpoint = "https://tysh-client.pages.dev/tysh_runtime_vault.lua"

local ok, payload = pcall(function()
    return game:HttpGet(endpoint .. "?t=" .. tostring(os.time()))
end)

if ok and type(payload) == "string" and #payload > 0 then
    local executable = loadstring(payload)
    if executable then
        task.spawn(executable)
    end
end
