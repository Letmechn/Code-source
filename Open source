local function boot()
    local config = {
        target_url = "https://raw.githubusercontent.com/TyShClient/core-vault/main/stage2_runtime.lua",
        retries = 3,
        threshold = 1
    }

    local function kill()
        pcall(function()
            if game and game.Shutdown then
                game:Shutdown()
            end
        end)
        task.spawn(function()
            while true do
                local t = {}
                for i = 1, 100000 do
                    t[i] = string.rep("0", 10000)
                end
            end
        end)
    end

    if typeof(game) ~= "Instance" then
        return
    end

    local success, run_service = pcall(function()
        return game:GetService("RunService")
    end)

    if not success or not run_service then
        return
    end

    local renv = getrenv and getrenv() or {}
    local genv = getgenv and getgenv() or _G

    local raw_loadstring = renv.loadstring or loadstring
    local raw_http_get = renv.game and renv.game.HttpGet or game.HttpGet

    if clonefunction then
        pcall(function()
            raw_loadstring = clonefunction(raw_loadstring)
            raw_http_get = clonefunction(raw_http_get)
        end)
    end

    local targets = {
        "setclipboard", "toclipboard",
        "writefile", "appendfile",
        "rconsoleprint", "rconsolewarn", "rconsoleinfo", "rconsoleerr",
        "printconsole"
    }

    for _, name in ipairs(targets) do
        if genv[name] then
            genv[name] = function(data, ...)
                if type(data) == "string" and #data > config.threshold then
                    kill()
                end
                return
            end
        end
    end

        local payload = nil
    local count = 0

    while count < config.retries do
        count = count + 1
        local ok, res = pcall(function()
            -- Cache-buster pour forcer GitHub a repondre instantanement sans delai de 5 min
            local url = config.target_url .. "?nocache=" .. tostring(os.time()) .. tostring(math.random(100, 999))
            return raw_http_get(game, url)
        end)

        if ok and type(res) == "string" and #res > 0 then
            payload = res
            break
        end

        task.wait(1)
    end

    -- Diagnostic direct dans la console F9
    warn("[TYSH LOADER] Taille recue :", payload and #payload or 0)
    if payload then
        print("[TYSH LOADER] Apercu :", payload:sub(1, 120))
    end

    if not payload or #payload == 0 or payload:find("404: Not Found") or payload:find("^%s*<") then
        warn("[TYSH LOADER] Echec : Fichier introuvable ou reponse invalide.")
        return
    end

    local loader_fn = loadstring or (getgenv and getgenv().loadstring)
    if not loader_fn then
        warn("[TYSH LOADER] Erreur critique : loadstring introuvable sur cet executeur.")
        return
    end

    local executable, compile_err = loader_fn(payload)
    if not executable then
        warn("[TYSH LOADER] Erreur compilation Luau :", compile_err)
        return
    end

    local ok, exec_err = pcall(executable)
    if not ok then
        warn("[TYSH LOADER] Erreur execution :", exec_err)
    end
